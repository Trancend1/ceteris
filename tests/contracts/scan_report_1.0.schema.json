{
  "$defs": {
    "Estimate": {
      "additionalProperties": false,
      "properties": {
        "delta": {
          "title": "Delta",
          "type": "number"
        },
        "delta_relative": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delta Relative"
        },
        "interval_90": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Interval 90",
          "type": "array"
        },
        "metric": {
          "const": "auc",
          "default": "auc",
          "title": "Metric",
          "type": "string"
        },
        "ood_score": {
          "title": "Ood Score",
          "type": "number"
        }
      },
      "required": [
        "delta",
        "delta_relative",
        "interval_90",
        "ood_score"
      ],
      "title": "Estimate",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Column"
        },
        "issue_type": {
          "title": "Issue Type",
          "type": "string"
        },
        "observed_or_estimated": {
          "enum": [
            "observed",
            "estimated"
          ],
          "title": "Observed Or Estimated",
          "type": "string"
        },
        "recovery_potential": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recovery Potential"
        },
        "rows_affected_pct": {
          "title": "Rows Affected Pct",
          "type": "number"
        }
      },
      "required": [
        "issue_type",
        "column",
        "rows_affected_pct",
        "observed_or_estimated",
        "recovery_potential"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "experimental": {
          "title": "Experimental",
          "type": "boolean"
        },
        "profile_schema_version": {
          "title": "Profile Schema Version",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "experimental",
        "profile_schema_version"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "properties": {
        "noise_floor_estimated": {
          "title": "Noise Floor Estimated",
          "type": "number"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "value": {
          "enum": [
            "material",
            "tidak_material",
            "tidak_yakin"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "threshold",
        "noise_floor_estimated",
        "reasons"
      ],
      "title": "Status",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "condition": {
      "const": "dibanding model yang dilatih pada versi bersih dan dievaluasi pada data bersih",
      "default": "dibanding model yang dilatih pada versi bersih dan dievaluasi pada data bersih",
      "title": "Condition",
      "type": "string"
    },
    "estimate": {
      "$ref": "#/$defs/Estimate"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "input_warnings": {
      "items": {
        "type": "string"
      },
      "title": "Input Warnings",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelInfo"
    },
    "scan_id": {
      "title": "Scan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/Status"
    }
  },
  "required": [
    "scan_id",
    "model",
    "estimate",
    "status",
    "findings",
    "input_warnings"
  ],
  "title": "ScanReport",
  "type": "object"
}
